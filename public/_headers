# Security headers for all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # CSP: allows self-hosted scripts/styles/images, inline styles for KaTeX/Tailwind,
  # dynamic imports (Mermaid), and data: URIs for inline images/SVGs.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';

# OG image — cached for 7 days
/og-image.svg
  Cache-Control: public, max-age=604800

# Service worker — must never be cached
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# PWA icons — immutable, cache aggressively
/icon-*.png
  Cache-Control: public, max-age=31536000, immutable

/manifest.json
  Cache-Control: public, max-age=604800

# Next.js static assets (fingerprinted by build — safe to cache forever)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# HTML — short cache since this is the PWA entry point
/
  Cache-Control: public, max-age=3600
