# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# nyc (istanbul) output
/.nyc_output

# next.js
/.next/
/out/

# production
/build

# distribution folders
/dist

# misc
.DS_Store
*.pem

# OS generated files
Thumbs.db
ehthumbs.db
desktop.ini

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# general logs
logs
*.log

# env files (can opt-in for committing if needed)
.env*

# keep an example env if present
!.env.example

# vercel
.vercel

# vercel build output
.vercel_build_output

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / IDE
.vscode/
.idea/
*.code-workspace
.claude/

# cache / tooling
/.cache
/.parcel-cache
/.turbo
/.next/cache
/node_modules/.cache

# local database files
*.sqlite
*.db
*.sqlite3
